# Base image comes from the inter-CU-UP relocation tree: ci-scripts/cuup-reloc-sync.sh
# in OAI_EWOC builds oai-gnb / oai-nr-cuup / oai-nr-ue tagged :reloc from branch
# cuup-reloc, with OAI's E2 agent compiled in (E2=ON).
#
# Do NOT point this back at a :latest tag.  :latest is built from develop and has
# neither the change of gNB-CU-UP state machine nor the telnet cuup_reloc command,
# and nothing in the deploy would tell you -- the containers come up healthy and
# the handover simply does not exist.  To check what an image carries:
#   docker image inspect -f '{{index .Config.Labels "reloc.commit"}}' oai-gnb:reloc
#was: FROM oai-gnb:latest
FROM oai-gnb:reloc

#ENV USE_ADDITIONAL_OPTIONS "--sa -E --rfsim"

HEALTHCHECK --interval=10s --timeout=5s --retries=5 CMD pgrep nr-softmodem || exit 1
# Base commands to let the container be configured for Mininet integration
RUN apt update --fix-missing && apt upgrade -y && \
    apt-get install apt-utils net-tools iputils-ping -y && \
    apt-get install bash bash-completion ethtool -y && \
    apt-get  install iproute2 busybox-static iperf -y && \
    apt-get  install stress-ng curl tcpdump netcat-openbsd -y && \
    apt-get install  libssl-dev libsctp-dev telnet -y && \
    apt-get  clean && \
    rm -rf /var/lib/apt/lists/*

COPY ./dockerfiles/volumes/gnb.sa.band78.106prb.rfsim.conf /opt/oai-gnb/etc/gnb.conf
#RUN  mkdir /usr/local/lib/flexric
#COPY ./dockerfiles/volumes/Flexric_Service_Models/flexric /usr/local/lib/flexric

EXPOSE 36421/sctp

# Original CMD ["/opt/oai-gnb/bin/nr-softmodem" "-O" "/opt/oai-gnb/etc/gnb.conf","--sa", "-E", "--rfsim"]
ENTRYPOINT [""]
CMD ["sh", "-c", "sleep infinity"]
