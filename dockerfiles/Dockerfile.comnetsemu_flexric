FROM flexric_test:comnetsemu AS flexric

# Never let apt/debconf stop to ask a question (tzdata, keyboard-configuration,
# changed conffiles): a build has no terminal, so a prompt waits forever.  The
# first RUN below upgraded without this, and only the second block set it.
# The Acquire options make an unreachable mirror or PPA fail within minutes
# instead of hanging the build.  ForceIPv4: on core, connections to
# archive.ubuntu.com stalled ("Ign: ... jammy InRelease" after a 30 s wait, then
# a hang on the package lists) while security.ubuntu.com downloaded at once --
# the pattern of an AAAA address tried first with no working IPv6 route.  The
# APT_FORCE_IPV4 build-arg adapt_docker_images.sh passes is not read by this
# Dockerfile, so it never had an effect.
ENV DEBIAN_FRONTEND=noninteractive
RUN printf 'Acquire::ForceIPv4 "true";\nAcquire::Retries "3";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\nDpkg::Options { "--force-confdef"; "--force-confold"; };\n' > /etc/apt/apt.conf.d/99build

RUN apt update --fix-missing && apt upgrade -y && \
    apt-get install apt-utils net-tools iputils-ping -y && \
    apt-get install bash bash-completion ethtool -y && \
    apt-get  install iproute2 busybox-static iperf -y && \
    apt-get  install stress-ng curl tcpdump netcat-openbsd -y && \
    apt-get install  python3 libssl-dev libsctp-dev -y && \
    apt-get  clean && \
    rm -rf /var/lib/apt/lists/*

# No ppa:ubuntu-toolchain-r/test any more: add-apt-repository talks to the
# Launchpad API from Python, outside apt's ForceIPv4/timeouts, and hung the build
# on core.  Nothing needs it -- gcc-12/g++-12 are in jammy's own archive.
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
       build-essential \
       libsctp-dev \
       git \
       wget \
       tar \
       m4 \
       automake \
       libtool \
       python3 \
       cmake \
       cmake-curses-gui \
       bison \
       flex \
       gdb \
       gcc-12 \
       g++-12 \
       libpcre2-dev \
       python3-dev \
       python3-pip \
       libsctp1 \
       libstdc++6 \
       sqlite3 \
       && \
    apt-get clean


RUN pip3 install requests prometheus_client prometheus-flask-exporter

#COPY /dockerfiles/volumes/config.yaml /openair-amf/etc/config.yaml
COPY ./dockerfiles/volumes/flexric_gnb.conf /usr/local/etc/flexric/flexric_gnb.conf
COPY ./dockerfiles/volumes/flexric_cu.conf /usr/local/etc/flexric/flexric_cu.conf
COPY ./dockerfiles/volumes/flexric_du.conf /usr/local/etc/flexric/flexric_du.conf
COPY ./dockerfiles/volumes/flexric_cucp.conf /usr/local/etc/flexric/flexric_cucp.conf
COPY ./dockerfiles/volumes/flexric_cuup.conf /usr/local/etc/flexric/flexric_cuup.conf
#COPY ./dockerfiles/volumes/ric.conf /usr/local/etc/flexric/ric.conf
COPY ./dockerfiles/volumes/flexric.conf /usr/local/etc/flexric/flexric.conf
EXPOSE 36421/sctp 36422/sctp
WORKDIR /usr/local/flexric/xApp

RUN echo 'alias go="/usr/local/bin/nearRT-RIC -c /usr/local/etc/flexric/flexric.conf "' >> ~/.bashrc

ENTRYPOINT [""]
CMD ["sh", "-C", "sleep infinity"]
#CMD ["sh", "-c", "/flexric/build/examples/ric/nearRT-RIC > /usr/local/etc/flexric/flexric-remote.log 2>&1"]
