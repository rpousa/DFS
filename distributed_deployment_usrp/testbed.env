# Testbed settings for distributed_deployment_usrp.
# Sourced (exported) by the deploy scripts, stop.sh, deploy-ue.sh and
# setup-usrp-host.sh. Check every "CHECK" against the real hardware.

# ---- LAN (one switch) -------------------------------------------------------
CORE_IP=192.168.1.210          # cgcc         enp0s31f6
CO_IP=192.168.1.219            # centraloffice eno1
EDGE_IP=192.168.1.221          # edge         eno1

# ---- Edge: DU on its USRP ------------------------------------------------------
# CHECK: which two ports are the SFP+ links to the USRP (ethtool -i <if>: driver
# i40e/ice and "Speed: 10000Mb/s" in ethtool <if>). Guess from "ip -br addr":
# eno10np0 and eno13np3 are up with no address.
EDGE_SFP0_IF=eno10np0
EDGE_SFP1_IF=eno13np3
EDGE_SFP0_SUBNET=192.168.10.0/24
EDGE_SFP1_SUBNET=192.168.20.0/24
EDGE_SFP0_GW=192.168.10.254    # unused address (macvlan needs a gateway)
EDGE_SFP1_GW=192.168.20.254
EDGE_HOST_SFP0_IP=192.168.10.1 # host side, for uhd_find_devices / probing
EDGE_HOST_SFP1_IP=192.168.20.1
EDGE_DU_SFP0_IP=192.168.10.10  # DU container on each link
EDGE_DU_SFP1_IP=192.168.20.10
# CHECK: USRP addresses (uhd_find_devices). Defaults: N310 192.168.10.2 / .20.2;
# X310 10 GbE image 192.168.40.2 / .30.2 (then change the subnets above too).
# N310: add mgmt_addr=<RJ45 address>.
EDGE_SDR_ARGS=addr=192.168.10.2,second_addr=192.168.20.2,clock_source=internal,time_source=internal
EDGE_ATT_TX=0
EDGE_ATT_RX=0
EDGE_MAX_RXGAIN=75
# X310 has no 122.88 MHz master clock: 273 PRB needs 3/4 sampling, add -E here.
# N310: leave empty (122.88 Msps).
EDGE_DU_EXTRA_OPTS=
EDGE_DU_CPUSET=3-20
EDGE_DU_CPUS=18.0
EDGE_DU_THREAD_POOL=5,6,7,8,9,10,11,12

# ---- Centraloffice: UE on its USRP -------------------------------------------
# CHECK: guess from "ip -br addr": eno11np1 and eno12np2 are up with no address
# (eno2 / eno3 are the two links to the switch).
CO_SFP0_IF=eno11np1
CO_SFP1_IF=eno12np2
CO_SFP0_SUBNET=192.168.10.0/24
CO_SFP1_SUBNET=192.168.20.0/24
CO_SFP0_GW=192.168.10.254
CO_SFP1_GW=192.168.20.254
CO_HOST_SFP0_IP=192.168.10.1
CO_HOST_SFP1_IP=192.168.20.1
CO_UE_SFP0_IP=192.168.10.10
CO_UE_SFP1_IP=192.168.20.10
CO_SDR_ARGS=addr=192.168.10.2,second_addr=192.168.20.2,clock_source=internal,time_source=internal
# -E for an X310 (as on the DU: both ends must use the same sampling).
# Gains once the RF path is known, e.g. --ue-rxgain 80 --ue-txgain 0
CO_UE_EXTRA_OPTS=
CO_UE_CPUSET=2-13
CO_UE_CPUS=12.0
