# Testbed settings for distributed_deployment_usrp.
# Sourced (exported) by the deploy scripts, stop.sh, deploy-ue.sh and
# setup-usrp-host.sh. Check every "CHECK" against the real hardware.

# ---- LAN (one switch) -------------------------------------------------------
CORE_IP=192.168.1.210          # cgcc         enp0s31f6
CO_IP=192.168.1.219            # centraloffice eno1
EDGE_IP=192.168.1.221          # edge         eno1

# ---- Radio profile (DU on the edge + UE on the centraloffice must match) ----
# 106 = 40 MHz, 61.44 Msps: bring-up profile. The Xeon D hosts underrun on TX
#       at 100 MHz 2x2 through the kernel UDP stack (one UHD TX stream).
# 273 = 100 MHz, 122.88 Msps: set RADIO_PRB=273 UE_CENTER_HZ=3450720000 UE_SSB_SC=1518
RADIO_PRB=106
UE_CENTER_HZ=3319680000
UE_SSB_SC=516
# Antennas per side. The Keysight PROPSIM emulation (Emulation7) is SISO 1x1:
# BS TX1 -> MS RX1 (downlink), MS TX1 -> BS RX1 (uplink). Only N310 channel 0
# (daughterboard A: TX/RX = TX, RX2 = RX) is cabled to it. 2 = 2x2 MIMO.
RADIO_ANT=1
# UE capability file. uecap_ports2.xml advertises 2 SRS ports / 2 layers and the
# UE asserts "SRS antenna ports (2) > nb_antennas_tx (1)" with RADIO_ANT=1.
# Empty = no file: OAI builds default (1-layer) capabilities. For 2x2 comment
# this line out (compose then passes --uecap_file uecap_ports2.xml).
UE_UECAP_OPT=
# Channel emulator centre frequency must equal UE_CENTER_HZ (= carrier centre).

# ---- Edge: DU on its USRP ------------------------------------------------------
# CHECK: which two ports are the SFP+ links to the USRP (ethtool -i <if>: driver
# i40e/ice and "Speed: 10000Mb/s" in ethtool <if>). Guess from "ip -br addr":
# eno10np0 and eno13np3 are up with no address.
# ---- Edge: N310 3198418 (FPGA XG) ----
EDGE_SFP0_IF=eno13np3          # N310 sfp0
EDGE_SFP1_IF=eno10np0          # N310 sfp1
EDGE_SFP0_SUBNET=192.168.30.0/24
EDGE_SFP1_SUBNET=192.168.40.0/24
EDGE_SFP0_GW=192.168.30.254
EDGE_SFP1_GW=192.168.40.254
EDGE_HOST_SFP0_IP=192.168.30.1
EDGE_HOST_SFP1_IP=192.168.40.1
EDGE_DU_SFP0_IP=192.168.30.10
EDGE_DU_SFP1_IP=192.168.40.10
EDGE_SDR_ARGS=mgmt_addr=192.168.30.2,addr=192.168.30.2,second_addr=192.168.40.2,clock_source=internal,time_source=internal
# zeroCorrelationZoneConfig 14 (Ncs 46, ~11 us at 30 kHz PRACH, was 12 = Ncs 27, ~6.5 us): the PROPSIM
# round trip (2 x 2.51 us insertion delay + N310 latency) shifted PRACH by one cyclic shift,
# so the DU answered the wrong RAPID (UE sent 51, DU detected 50).
EDGE_DU_EXTRA_OPTS="--usrp-tx-thread-config 1 --RUs.[0].ru_thread_core 13 --gNBs.[0].servingCellConfigCommon.[0].zeroCorrelationZoneConfig 14"  # N310: no -E. UHD TX write thread; ru_thread off core 3 (L1_tx_thread_core).
# CHECK: USRP addresses (uhd_find_devices). Defaults: N310 192.168.10.2 / .20.2;
# X310 10 GbE image 192.168.40.2 / .30.2 (then change the subnets above too).
# N310: add mgmt_addr=<RJ45 address>.
EDGE_ATT_TX=0
EDGE_ATT_RX=0
EDGE_MAX_RXGAIN=60            # PROPSIM output -50 dBm (raise if the emulator output is lower)
# X310 has no 122.88 MHz master clock: 273 PRB needs 3/4 sampling, add -E here.
# N310: leave empty (122.88 Msps).
EDGE_DU_CPUSET=3-20
EDGE_DU_CPUS=18.0
EDGE_DU_THREAD_POOL=5,6,7,8,9,10,11,12

# ---- Centraloffice: UE on its USRP -------------------------------------------
# CHECK: guess from "ip -br addr": eno11np1 and eno12np2 are up with no address
# (eno2 / eno3 are the two links to the switch).
CO_SFP0_IF=eno12np2            # N310 sfp0 (cables crossed vs. port names)
CO_SFP1_IF=eno11np1            # N310 sfp1
CO_SFP0_SUBNET=192.168.10.0/24
CO_SFP1_SUBNET=192.168.20.0/24
CO_SFP0_GW=192.168.10.254
CO_SFP1_GW=192.168.20.254
CO_HOST_SFP0_IP=192.168.10.1
CO_HOST_SFP1_IP=192.168.20.1
CO_UE_SFP0_IP=192.168.10.10
CO_UE_SFP1_IP=192.168.20.10
CO_SDR_ARGS=mgmt_addr=192.168.10.2,addr=192.168.10.2,second_addr=192.168.20.2,clock_source=internal,time_source=internal
# --cont-fo-comp 1: correct the carrier offset digitally. Without it the UE retunes the N310 LO
# after initial sync (nr-ue.c nrue_ru_set_freq); on the N310 that RPC stalls the UE ~60 ms
# ("Deadline missed for tx slot ... missed by 60611"), its TX goes late and RRC setup breaks.
CO_UE_EXTRA_OPTS="--usrp-tx-thread-config 1 --ue-rxgain 60 --ue-txgain 20 --cont-fo-comp 1"  # UHD TX write thread; RX gain for PROPSIM output -50 dBm; TX 20 dB below max (65 -> 45 dB) so the PROPSIM MS input does not cut off
# -E for an X310 (as on the DU: both ends must use the same sampling).
# Gains once the RF path is known, e.g. --ue-rxgain 80 --ue-txgain 0
CO_UE_CPUSET=2-13
CO_UE_CPUS=12.0
